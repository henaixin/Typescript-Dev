{
  "name": "typescript_stady",
  "version": "1.0.0",
  "description": "TypeScript 项目开发示例，支持多平台打包",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "package:win": "pkg . --targets node18-win-x64 --output build/typescript-demo-win-x64.exe",
    "package:mac": "pkg . --targets node18-macos-arm64 --output build/typescript-demo-macos-arm64",
    "package:linux-x64": "pkg . --targets node18-linux-x64 --output build/typescript-demo-linux-x64",
    "package:linux-arm64": "pkg . --targets node18-linux-arm64 --output build/typescript-demo-linux-arm64",
    "package:linux": "npm run package:linux-x64 && npm run package:linux-arm64",
    "package:current": "pkg . --output build/typescript-demo"
  },
  "keywords": [
    "typescript",
    "demo",
    "cross-platform"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "pkg": {
    "assets": [],
    "targets": [
      "node18"
    ],
    "outputPath": "build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "pkg": "^5.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "toml": "^4.1.1"
  }
}
